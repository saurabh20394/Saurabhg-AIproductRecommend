<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <saurabhg_airecommend>
            <general>
                <enabled>0</enabled>
                <debug_log>0</debug_log>
            </general>
            <tracking>
                <enabled>1</enabled>
                <consent_mode>magento_cookie</consent_mode>
                <consent_cookie>cookie_consent</consent_cookie>
                <consent_value/>
                <anonymous>1</anonymous>
                <personalize_customers>1</personalize_customers>
                <track_category>1</track_category>
                <track_search>1</track_search>
                <track_wishlist>1</track_wishlist>
                <async>1</async>
                <rate_limit>120</rate_limit>
                <max_batch>50</max_batch>
            </tracking>
            <privacy>
                <retention_days>180</retention_days>
                <analytics_retention_days>730</analytics_retention_days>
                <anonymous_profile_days>90</anonymous_profile_days>
                <attribution_window_days>7</attribution_window_days>
            </privacy>
            <ai>
                <embedding_provider>local</embedding_provider>
                <endpoint/>
                <api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <embedding_path>/v1/embeddings</embedding_path>
                <embedding_model>text-embedding-3-small</embedding_model>
                <ranking_enabled>0</ranking_enabled>
                <ranking_path>/v1/recommendations</ranking_path>
                <catalog_sync_enabled>0</catalog_sync_enabled>
                <catalog_sync_path>/v1/catalog/products</catalog_sync_path>
                <timeout_ms>800</timeout_ms>
                <batch_timeout>30</batch_timeout>
                <circuit_threshold>5</circuit_threshold>
                <circuit_cooldown>60</circuit_cooldown>
            </ai>
            <catalog>
                <embedding_fields>name,brand,categories,short_description,description</embedding_fields>
                <extra_attributes/>
                <brand_attribute>manufacturer</brand_attribute>
                <sync_qty>0</sync_qty>
                <batch_size>50</batch_size>
                <similar_top_k>20</similar_top_k>
                <max_similarity_candidates>3000</max_similarity_candidates>
            </catalog>
            <algorithms>
                <popular_window_days>30</popular_window_days>
                <trending_window_days>7</trending_window_days>
                <trending_half_life_hours>48</trending_half_life_hours>
                <co_purchase_window_days>365</co_purchase_window_days>
                <co_view_window_days>60</co_view_window_days>
                <relation_top_k>30</relation_top_k>
                <profile_half_life_days>14</profile_half_life_days>
            </algorithms>
            <ranking>
                <w_behavior>0.30</w_behavior>
                <w_similarity>0.25</w_similarity>
                <w_affinity>0.15</w_affinity>
                <w_popularity>0.10</w_popularity>
                <w_trending>0.10</w_trending>
                <w_conversion>0.05</w_conversion>
                <w_inventory>0.05</w_inventory>
                <max_boost>1</max_boost>
                <max_per_category>0</max_per_category>
            </ranking>
            <inventory>
                <exclude_out_of_stock>1</exclude_out_of_stock>
                <low_stock_threshold>5</low_stock_threshold>
                <excluded_skus/>
                <excluded_categories/>
                <excluded_types/>
            </inventory>
            <cache>
                <ttl>900</ttl>
                <personalized_ttl>300</personalized_ttl>
                <fallback_hours>24</fallback_hours>
            </cache>
            <storefront>
                <show_reason>1</show_reason>
                <show_add_to_cart>1</show_add_to_cart>
                <expose_score>0</expose_score>
            </storefront>
        </saurabhg_airecommend>
    </default>
</config>
