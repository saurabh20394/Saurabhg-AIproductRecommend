<?xml version="1.0"?>
<!--
/**
 * Saurabhg_AIproductRecommend
 *
 * Role mapping (configure in System > Permissions > User Roles):
 *   Administrator     - all resources
 *   Merchandiser      - units, rules, campaigns, simulator
 *   Marketing Manager - campaigns, segments, experiments, reports
 *   Analyst           - dashboard, reports (read only)
 *   Developer         - monitor, reindex, profiles API, configuration
 *
 * @copyright Copyright (C) 2026 Saurabh Gupta
 * @license   GPL-3.0-or-later
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::marketing">
                    <resource id="Saurabhg_AIproductRecommend::root" title="AI Recommendations" sortOrder="80">
                        <resource id="Saurabhg_AIproductRecommend::dashboard" title="Dashboard" sortOrder="10"/>
                        <resource id="Saurabhg_AIproductRecommend::units" title="Recommendation Units" sortOrder="20"/>
                        <resource id="Saurabhg_AIproductRecommend::rules" title="Business Rules" sortOrder="30"/>
                        <resource id="Saurabhg_AIproductRecommend::campaigns" title="Campaigns" sortOrder="40"/>
                        <resource id="Saurabhg_AIproductRecommend::segments" title="Customer Segments" sortOrder="50"/>
                        <resource id="Saurabhg_AIproductRecommend::experiments" title="A/B Experiments" sortOrder="60"/>
                        <resource id="Saurabhg_AIproductRecommend::simulator" title="Simulator / Explainability" sortOrder="70"/>
                        <resource id="Saurabhg_AIproductRecommend::reports" title="Reports" sortOrder="80"/>
                        <resource id="Saurabhg_AIproductRecommend::monitor" title="Index &amp; Queue Monitor" sortOrder="90">
                            <resource id="Saurabhg_AIproductRecommend::reindex" title="Run Reindex / Retry Jobs" sortOrder="10"/>
                        </resource>
                        <resource id="Saurabhg_AIproductRecommend::profiles" title="Customer Profiles (API)" sortOrder="100">
                            <resource id="Saurabhg_AIproductRecommend::profiles_delete" title="Delete / Anonymize Profiles" sortOrder="10"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Saurabhg_AIproductRecommend::config" title="Saurabh AI Product Recommendations" sortOrder="120"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
