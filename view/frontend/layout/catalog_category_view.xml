<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content.top">
            <block class="Saurabhg\AIproductRecommend\Block\Placement" name="airecommend.category.top" after="-">
                <arguments>
                    <argument name="placement" xsi:type="string">category_top</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="content.bottom">
            <block class="Saurabhg\AIproductRecommend\Block\Placement" name="airecommend.category.bottom">
                <arguments>
                    <argument name="placement" xsi:type="string">category_bottom</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
