$statusLabels = ['ok' => __('OK'), 'warning' => __('Warning'), 'down' => __('Down'), 'disabled' => __('Off')];

$change = static function (?array $change) use ($escaper): string {
    if ($change === null) {
        return '<span class="aipr-change aipr-change--none">' . $escaper->escapeHtml(__('no prior data')) . '</span>';
    }
    $arrow = ['up' => '&#9650;', 'down' => '&#9660;', 'flat' => '&#9644;'][$change['direction']];
    $value = ($change['value'] > 0 ? '+' : '') . $change['value'] . $change['unit'];
    return sprintf(
        '<span class="aipr-change aipr-change--%s" title="%s">%s %s</span>',
        $escaper->escapeHtmlAttr($change['direction']),
        $escaper->escapeHtmlAttr(__('Compared with the previous period of the same length')),
        $arrow,
        $escaper->escapeHtml($value)
    );
};
$rate = static fn($numerator, $denominator) => $denominator ? round($numerator / $denominator * 100, 1) . '%' : '–';
