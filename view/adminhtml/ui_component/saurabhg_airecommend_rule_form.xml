<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">saurabhg_airecommend_rule_form.saurabhg_airecommend_rule_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Business Rule</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save_and_continue" class="Saurabhg\AIproductRecommend\Block\Adminhtml\Edit\SaveAndContinueButton"/>
            <button name="save" class="Saurabhg\AIproductRecommend\Block\Adminhtml\Edit\SaveButton"/>
            <button name="delete" class="Saurabhg\AIproductRecommend\Block\Adminhtml\Edit\DeleteButton"/>
            <button name="back" class="Saurabhg\AIproductRecommend\Block\Adminhtml\Edit\BackButton"/>
        </buttons>
        <namespace>saurabhg_airecommend_rule_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>saurabhg_airecommend_rule_form.saurabhg_airecommend_rule_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="saurabhg_airecommend_rule_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="Saurabhg\AIproductRecommend\Ui\DataProvider\RuleForm" name="saurabhg_airecommend_rule_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>rule_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">Rule</label>
            <collapsible>false</collapsible>
            <opened>true</opened>
        </settings>
        <field name="rule_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>
        <field name="status" formElement="checkbox" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="name" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="priority" formElement="input" sortOrder="30">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="default" xsi:type="string">0</item>
            </item>
        </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Priority</label>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
                <notice translate="true">Higher priority runs first; exclusions always win over boosts; the first rule pinning a slot keeps it.</notice>
            </settings>
        </field>
        <field name="stop_further" formElement="checkbox" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Stop Further Rules Processing</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="from_date" formElement="date" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Active From</label>
                <validation>
                    <rule name="validate-date" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="to_date" formElement="date" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Active To</label>
                <validation>
                    <rule name="validate-date" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
    <fieldset name="scope" sortOrder="20">
        <settings>
            <label translate="true">Scope</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="store_ids" formElement="multiselect" sortOrder="10">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="default" xsi:type="string">0</item>
            </item>
        </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Store Views</label>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Saurabhg\AIproductRecommend\Model\Source\StoreView"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="customer_group_ids" formElement="multiselect" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Customer Groups</label>
                <notice translate="true">Leave empty for all groups.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Saurabhg\AIproductRecommend\Model\Source\CustomerGroup"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
        <field name="unit_codes" formElement="multiselect" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Recommendation Units</label>
                <notice translate="true">Leave empty for all units.</notice>
            </settings>
            <formElements>
                <multiselect>
                    <settings>
                        <options class="Saurabhg\AIproductRecommend\Model\Source\UnitCode"/>
                    </settings>
                </multiselect>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="conditions_set" sortOrder="30">
        <settings>
            <label translate="true">Conditions (all must match)</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <dynamicRows name="conditions" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="notice" xsi:type="string" translate="true">No conditions = the rule always applies within its scope.</item>
                </item>
            </argument>
            <settings>
                <addButtonLabel translate="true">Add Condition</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <label translate="true">Conditions</label>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="field" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Field</label>
                        <dataScope>field</dataScope>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Saurabhg\AIproductRecommend\Model\Source\RuleConditionField"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="operator" formElement="select" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Operator</label>
                        <dataScope>operator</dataScope>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Saurabhg\AIproductRecommend\Model\Source\Operator"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="value" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Value</label>
                        <dataScope>value</dataScope>
                    </settings>
                </field>
                <actionDelete name="delete" sortOrder="40">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Remove</label>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
    <fieldset name="actions_set" sortOrder="40">
        <settings>
            <label translate="true">Actions</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <dynamicRows name="actions" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="notice" xsi:type="string" translate="true">Boost amounts are added to the 0-1 relevance score (capped by Maximum Total Boost). Use negative amounts to penalize.</item>
                </item>
            </argument>
            <settings>
                <addButtonLabel translate="true">Add Action</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <label translate="true">Actions</label>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="type" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Action</label>
                        <dataScope>type</dataScope>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Saurabhg\AIproductRecommend\Model\Source\RuleActionType"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="value" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Value</label>
                        <dataScope>value</dataScope>
                    </settings>
                </field>
                <field name="amount" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Amount</label>
                        <dataScope>amount</dataScope>
                    </settings>
                </field>
                <actionDelete name="delete" sortOrder="40">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Remove</label>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
</form>
