<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">saurabhg_airecommend_experiment_listing.saurabhg_airecommend_experiment_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add A/B Experiment</label>
            </button>
        </buttons>
        <spinner>saurabhg_airecommend_experiment_listing_columns</spinner>
        <deps>
            <dep>saurabhg_airecommend_experiment_listing.saurabhg_airecommend_experiment_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="saurabhg_airecommend_experiment_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">experiment_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Saurabhg_AIproductRecommend::experiments</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="saurabhg_airecommend_experiment_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>experiment_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected experiments and their assignments?</message>
                        <title translate="true">Delete</title>
                    </confirm>
                    <url path="*/*/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="saurabhg_airecommend_experiment_listing_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">saurabhg_airecommend_experiment_listing.saurabhg_airecommend_experiment_listing.saurabhg_airecommend_experiment_listing_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids" sortOrder="0">
            <settings>
                <indexField>experiment_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="experiment_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="unit_code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Unit</label>
            </settings>
        </column>
        <column name="start_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="40">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Start</label>
            </settings>
        </column>
        <column name="end_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="50">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">End</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Saurabhg\AIproductRecommend\Model\Source\ExperimentStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Saurabhg\AIproductRecommend\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="idField" xsi:type="string">experiment_id</item>
                    <item name="editUrlPath" xsi:type="string">saurabhg_airecommend/experiment/edit</item>
                    <item name="deleteUrlPath" xsi:type="string">saurabhg_airecommend/experiment/delete</item>
                    <item name="reportUrlPath" xsi:type="string">saurabhg_airecommend/experiment/report</item>
                </item>
            </argument>
            <settings>
                <indexField>experiment_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
